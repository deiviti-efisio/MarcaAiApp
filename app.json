{
  "expo": {
    "name": "MeuShow",
    "slug": "APP_MOBILE_MARCA_AI",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icone_app_1024.png",
    "scheme": "marcaai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#667eea",
      "dark": {
        "backgroundColor": "#4c51bf"
      }
    },
    "ios": {
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.marcaai.app",
      "buildNumber": "109",
      "icon": "./assets/images/icone_app_1024.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Este app precisa acessar sua galeria de fotos para permitir que você selecione uma foto de perfil.",
        "NSCameraUsageDescription": "Este app precisa acessar sua câmera para permitir que você tire uma foto para o perfil.",
        "NSMicrophoneUsageDescription": "O MeuShow usa o microfone para você criar eventos falando a data, o valor e o local.",
        "NSSpeechRecognitionUsageDescription": "O MeuShow usa o reconhecimento de fala para preencher o evento a partir do que você disser.",
        "NSDocumentsFolderUsageDescription": "Este app precisa acessar a pasta de documentos para salvar e compartilhar relatórios em PDF.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "marcaai",
            "CFBundleURLSchemes": [
              "marcaai"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.marcaaipro.app",
      "versionCode": 55,
      "googleServicesFile": "./android/app/google-services.json",
      "icon": "./assets/images/icone_512x512.png",
      "adaptiveIcon": {
        "backgroundColor": "#6173EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "marcaai"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icone_app_1024.png"
    },
    "plugins": [
      "expo-iap",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.169304206053-642isf3lub3ds2thkiupcje9r7lo7dh7"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-transparent.png",
          "resizeMode": "contain",
          "backgroundColor": "#667eea",
          "dark": {
            "backgroundColor": "#4c51bf"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Este app precisa acessar sua galeria de fotos para permitir que você selecione uma foto de perfil.",
          "cameraPermission": "Este app precisa acessar sua câmera para permitir que você tire uma foto para o perfil."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O MeuShow usa o microfone para você criar eventos falando a data, o valor e o local.",
          "speechRecognitionPermission": "O MeuShow usa o reconhecimento de fala para preencher o evento a partir do que você disser.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "23d54c76-03c0-4faa-ae6b-41a42ab5c73b"
      }
    }
  }
}
